  },
  {
    "htmlValue": "<div class=\"table-wrapper\"><table class=\"borderGGrey400\" style=\"width:100%\"><thead><tr><th style=\"width:33.2734%\"><p>Variant</p></th><th style=\"width:33.3333%;text-align:center\"><p>M3</p></th><th style=\"width:33.3333%;text-align:center\"><p>M3 Expressive</p></th></tr></thead><tbody><tr><td><p>Collapsed navigation rail<br /></p></td><td><p>--</p></td><td><p>Available</p></td></tr><tr><td><p>Expanded navigation rail <br /></p></td><td><p>--</p></td><td><p>Available</p></td></tr><tr><td><p>Navigation rail (baseline)<br /></p></td><td><p>Available</p></td><td><p>Not recommended.</p><p>Use <strong>collapsed navigation rail</strong>.<br /></p></td></tr></tbody></table></div>"
