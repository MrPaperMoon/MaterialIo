  },
  {
    "footer": "<ol><li>Container</li><li>Icon (optional) </li><li>Headline (optional)</li><li>Supporting text </li><li>Divider (optional) </li><li>Button label text</li><li>Scrim</li></ol>",
    "altText": "Anatomy diagram numbering dialog elements.",
