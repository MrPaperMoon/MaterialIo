    "htmlValue": "<h4>Toggle</h4>"
  },
  {
    "footer": "<p id=\"isPasted\">A. Unselected, B. Selected</p><ol class=\"decimal\"><li>Enabled </li><li>Disabled </li><li>Hovered </li><li>Focused </li><li>Pressed</li></ol>",
