    "htmlValue": "<h2>Variants</h2>"
  },
  {
    "footer": "<ol><li>FAB</li><li>Medium FAB</li><li>Large FAB</li></ol>",
    "altText": "An icon on the container of a FAB, medium FAB, and large FAB.",
